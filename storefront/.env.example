# URL of the Medusa backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key (Medusa Admin → Settings → Publishable API Keys,
# or the key created by `npm run seed` in the backend)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_replace_me

# Optional: region used to calculate prices. Defaults to the first region.
# NEXT_PUBLIC_MEDUSA_REGION_ID=reg_...
