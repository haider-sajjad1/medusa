# PostgreSQL connection (create the database first, e.g. `createdb medusa`)
DATABASE_URL=postgres://postgres:your_password@localhost:5432/medusa
DB_NAME=medusa

# CORS: storefront (Next.js) runs on :3000, admin on :9000
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:5173,http://localhost:9000

# Generate strong values, e.g. `openssl rand -hex 32`
JWT_SECRET=replace_me
COOKIE_SECRET=replace_me

# Optional: Medusa falls back to in-memory modules when this is not set
# REDIS_URL=redis://localhost:6379
